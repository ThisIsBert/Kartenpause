{
  "name": "kartenpause",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Lokale Tests für den Kartenprojektions-Prototyp",
  "scripts": {
    "test:trace": "node --test tests/trace.unit.mjs tests/basemap-source.unit.mjs tests/polygon-operation.unit.mjs tests/curves.unit.mjs",
    "test:wand": "node --test tests/intelligent-selection.unit.mjs tests/selection-contours.unit.mjs",
    "test:geodata": "node --test tests/geodata.unit.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:report": "playwright show-report output/playwright/report",
    "test:i18n": "node --test tests/i18n.unit.mjs"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "jsts": "2.12.1",
    "leaflet": "1.9.4",
    "lucide": "0.468.0",
    "maplibre-gl": "^6.14.0",
    "numeric": "1.2.6",
    "osmtogeojson": "3.0.0-beta.5",
    "proj4": "2.21.0"
  },
  "overrides": {
    "osmtogeojson": {
      "@xmldom/xmldom": "0.8.15"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "vite": "^8.3.0"
  }
}
